---
interface Props {
  name: string;
  title: string;
  bio: string;
  email?: string;
  phone?: string;
  initials?: string;
}

const { name, title, bio, email, phone, initials } = Astro.props;
const displayInitials = initials ?? name
  .split(' ')
  .map(n => n[0])
  .slice(0, 2)
  .join('');
---

<article class="agent">
  <div class="agent__avatar" aria-hidden="true">{displayInitials}</div>
  <div class="agent__body">
    <h3 class="agent__name">{name}</h3>
    <div class="agent__title">{title}</div>
    <p class="agent__bio">{bio}</p>
    {(email || phone) && (
      <ul class="agent__contact">
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {phone && <li><a href={`tel:${phone.replace(/[^0-9+]/g, '')}`}>{phone}</a></li>}
      </ul>
    )}
  </div>
</article>

<style>
  .agent {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .agent__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-navy);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
  }

  .agent__name {
    margin: 0 0 0.15rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-navy);
    letter-spacing: 0;
  }

  .agent__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent-dark);
    margin-bottom: 0.75rem;
  }

  .agent__bio {
    color: var(--color-muted);
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
  }

  .agent__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }
</style>
