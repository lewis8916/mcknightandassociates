---
const year = 2026;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <div class="site-footer__name">McKnight <span class="amp">&amp;</span> Associates</div>
      <div class="site-footer__tag">Realtors · Property Management · Since 2003</div>
      <p class="site-footer__blurb">
        A Dallas-area real estate brokerage helping families, investors, and property
        owners across the North Texas metroplex.
      </p>
      <a href="https://www.facebook.com/Mcknightandassociates/" class="site-footer__social" aria-label="Facebook" rel="noopener" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.5 22v-9h3l.5-4h-3.5V6.5c0-1.15.32-1.93 1.97-1.93H17V1.17C16.63 1.12 15.5 1 14.17 1 11.4 1 9.5 2.69 9.5 5.8V9H6.5v4h3v9h4z"/>
        </svg>
      </a>
    </div>

    <div>
      <div class="site-footer__heading">Contact</div>
      <ul class="site-footer__list">
        <li><a href="tel:+12147404989">214-740-4989</a></li>
        <li><a href="mailto:Lewis@mcknight.com">Lewis@mcknight.com</a></li>
      </ul>
      <div class="site-footer__heading" style="margin-top:1.75rem;">Office</div>
      <address class="site-footer__address">
        3400 N Central Expy #110-217<br />
        Richardson, TX 75080
      </address>
    </div>

    <div>
      <div class="site-footer__heading">Explore</div>
      <ul class="site-footer__list">
        <li><a href="/buy/">Buy</a></li>
        <li><a href="/rent/">Rent</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__meta">
    <span>© {year} McKnight &amp; Associates. All rights reserved.</span>
    <span>Equal Housing Opportunity · Licensed Texas Real Estate Brokerage</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-dark);
    color: #a3a6ad;
    margin-top: 0;
  }

  .site-footer a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover { color: var(--color-brand); }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3rem;
    padding-block: 4rem 2.5rem;
  }

  @media (max-width: 780px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-block: 3rem 1.75rem;
    }
  }

  .site-footer__name {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .site-footer__name .amp { color: var(--color-brand); }

  .site-footer__tag {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #a3a6ad;
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .site-footer__blurb {
    color: #a3a6ad;
    font-size: 0.93rem;
    max-width: 42ch;
    margin-bottom: 1.25rem;
    line-height: 1.55;
  }

  .site-footer__social {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    color: #ffffff;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .site-footer__social:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
  }

  .site-footer__heading {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #ffffff;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.92rem;
  }

  .site-footer__address {
    font-style: normal;
    color: #a3a6ad;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .site-footer__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-block: 1.5rem 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: #6b6e75;
  }
</style>
