---
import logoSrc from '../assets/logo.jpg';

const links = [
  { href: '/', label: 'Home' },
  { href: '/buy/', label: 'Buy' },
  { href: '/rent/', label: 'Rent' },
  { href: '/team/', label: 'Agents' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="McKnight & Associates — home">
      <img src={logoSrc.src} width={logoSrc.width} height={logoSrc.height} alt="McKnight & Associates Realtors" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-toggle__label" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <div class="site-header__right">
      <nav class="site-nav" aria-label="Primary">
        <ul>
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={['site-nav__link', { 'is-active': isActive(href) }]}
                aria-current={isActive(href) ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href="tel:+12147404989" class="site-header__phone">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>214-740-4989</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    height: 216px;
    overflow: hidden;
  }

  .brand img {
    height: 340px;
    width: auto;
    display: block;
    margin-block: -62px;
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
  }

  .site-nav__link {
    text-decoration: none;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
    padding-block: 0.6rem;
    position: relative;
    transition: color 0.15s ease;
  }

  .site-nav__link:hover { color: var(--color-brand); }

  .site-nav__link.is-active {
    color: var(--color-ink);
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-brand);
    border-radius: 2px;
  }

  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.15rem;
    background: var(--color-brand);
    color: #ffffff;
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    border-radius: var(--radius);
    transition: background 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .site-header__phone:hover {
    background: var(--color-brand-dark);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .nav-toggle,
  .nav-toggle__label {
    display: none;
  }

  @media (max-width: 1024px) {
    .brand { height: 180px; }
    .brand img { height: 284px; margin-block: -52px; }
    .site-nav ul { gap: 1.4rem; }
    .site-nav__link { font-size: 0.86rem; }
    .site-header__right { gap: 1.25rem; }
  }

  @media (max-width: 860px) {
    .nav-toggle__label {
      display: inline-flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
      order: 3;
    }

    .nav-toggle__label span {
      display: block;
      width: 26px;
      height: 2px;
      background: var(--color-ink);
      transition: transform 0.2s ease;
    }

    .brand { height: 144px; }
    .brand img { height: 227px; margin-block: -41px; }

    .site-header__right {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #ffffff;
      border-bottom: 1px solid var(--color-line);
      display: none;
      box-shadow: var(--shadow-md);
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.5rem 1rem;
    }

    .site-nav__link {
      display: block;
      padding-block: 0.9rem;
      border-bottom: 1px solid var(--color-line);
      font-size: 0.95rem;
    }

    .site-header__phone {
      margin: 0 1.5rem 1.5rem;
      justify-content: center;
    }

    .nav-toggle:checked ~ .site-header__right {
      display: flex;
    }
  }

  @media (max-width: 400px) {
    .brand { height: 117px; }
    .brand img { height: 184px; margin-block: -33px; }
  }
</style>
