---
const links = [
  { href: '/', label: 'Home' },
  { href: '/agents/', label: 'Agents' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="McKnight & Associates — home">
      <span class="brand__mark">M</span>
      <span class="brand__wordmark">
        <span class="brand__name">McKnight</span>
        <span class="brand__tag">&amp; Associates</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-toggle__label" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['site-nav__link', { 'is-active': isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: saturate(180%) blur(10px);
    background-color: rgba(250, 247, 242, 0.9);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-navy);
  }

  .brand__mark {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--color-navy);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.35rem;
    border-radius: 2px;
  }

  .brand__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .brand__tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-muted);
    margin-top: 0.25rem;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2rem;
  }

  .site-nav__link {
    text-decoration: none;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 500;
    padding-block: 0.5rem;
    position: relative;
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
  }

  .site-nav__link:hover {
    color: var(--color-accent-dark);
  }

  .nav-toggle,
  .nav-toggle__label {
    display: none;
  }

  @media (max-width: 720px) {
    .nav-toggle__label {
      display: inline-flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
    }

    .nav-toggle__label span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--color-navy);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
      display: none;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 1.25rem 1.25rem;
    }

    .site-nav__link {
      display: block;
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--color-line);
    }

    .nav-toggle:checked ~ .site-nav {
      display: block;
    }
  }
</style>
