---
import Layout from '../layouts/Layout.astro';
import AgentCard from '../components/AgentCard.astro';

// TODO: Replace this seed data with real agents before launch.
const agents = [
  {
    name: 'Lewis McKnight',
    title: 'Broker / Owner',
    bio: 'Founder of McKnight & Associates. Dallas native with a background in negotiation and property investment across the northern suburbs.',
    email: 'lewis@mcknight.com',
    phone: '(555) 555-5555',
  },
  {
    name: 'Agent Two',
    title: 'REALTOR® · Buyer Specialist',
    bio: 'Focused on first-time buyers and relocations into Plano and Frisco. Known for patient, thorough tours and clear-eyed contract reviews.',
    email: 'agent-two@mcknight.com',
    phone: '(555) 555-5556',
  },
  {
    name: 'Agent Three',
    title: 'REALTOR® · Listing Specialist',
    bio: 'Handles seller-side deals across Richardson and Garland. Deep knowledge of pricing strategy, staging, and negotiation.',
    email: 'agent-three@mcknight.com',
    phone: '(555) 555-5557',
  },
];
---

<Layout
  title="Our agents"
  description="Meet the team at McKnight & Associates — Dallas-area real estate agents serving Richardson, Plano, Garland, and Frisco."
  path="/agents/"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">The team</span>
      <h1>Meet the people behind the deals.</h1>
      <p class="lede">
        We're a small, deliberate team. Every client is worked directly by an agent — no
        handoffs to assistants, no lead-farming pipeline. That's the whole model.
      </p>

      <div class="grid grid--2" style="margin-top:3rem;">
        {agents.map(agent => <AgentCard {...agent} />)}
      </div>

      <div class="join">
        <div>
          <h2 style="margin-bottom:0.5rem;">Interested in joining us?</h2>
          <p style="color:var(--color-muted);margin:0;">
            We're always open to conversations with experienced agents who share our approach.
          </p>
        </div>
        <a href="/contact/" class="btn btn--ghost">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .join {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-top: 4rem;
    padding: 2rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }
</style>
