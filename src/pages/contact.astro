---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Reach McKnight & Associates. Office at 3400 N Central Expy, Richardson TX. Call 214-740-4989 or send a message."
  path="/contact/"
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let's talk about<br /><span class="brand-text">what's next.</span></h1>
      <p class="lede">
        Buying, selling, renting, listing an investment property — whatever's on your
        mind, we're happy to walk through it. Reach out however works best for you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Form -->
        <form
          class="contact-form"
          name="contact"
          method="POST"
          action="https://formspree.io/f/xbdneyaw"
          aria-labelledby="contact-form-heading"
        >
          <input type="hidden" name="_subject" value="New inquiry — McKnight & Associates" />

          <h2 id="contact-form-heading" class="visually-hidden">Contact form</h2>

          <div class="field-row">
            <div class="field">
              <label for="first-name">First name</label>
              <input id="first-name" name="first-name" type="text" required autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="last-name">Last name</label>
              <input id="last-name" name="last-name" type="text" required autocomplete="family-name" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <fieldset class="field field--radios">
            <legend>Interested in</legend>
            <div class="radios">
              <label class="radio">
                <input type="radio" name="interest" value="buy" checked />
                <span>Buying</span>
              </label>
              <label class="radio">
                <input type="radio" name="interest" value="sell" />
                <span>Selling</span>
              </label>
              <label class="radio">
                <input type="radio" name="interest" value="rent" />
                <span>Renting</span>
              </label>
              <label class="radio">
                <input type="radio" name="interest" value="manage" />
                <span>Property mgmt</span>
              </label>
              <label class="radio">
                <input type="radio" name="interest" value="invest" />
                <span>Investing</span>
              </label>
            </div>
          </fieldset>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>
              I agree to be contacted by McKnight and Associates via call, email, and SMS.
              Message and data rates may apply. Message frequency varies. Text HELP for
              help or call us directly. To opt out of SMS, text STOP to cancel. For more
              information on how your opt-in data will be used, view our
              <a href="/privacy/">Privacy Policy</a>.
            </span>
          </label>

          <button type="submit" class="btn btn--brand btn--lg">Send message</button>
          <p class="form-note">We reply personally, usually within one business day.</p>
        </form>

        <!-- Sidebar -->
        <aside class="contact-aside">
          <div class="contact-card">
            <div class="contact-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="contact-card__label">Call</div>
            <a href="tel:+12147404989" class="contact-card__value">214-740-4989</a>
            <div class="contact-card__meta">Mon – Sat, 9am – 7pm CT</div>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="contact-card__label">Email</div>
            <a href="mailto:Lewis@mcknight.com" class="contact-card__value contact-card__value--small">Lewis@mcknight.com</a>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="contact-card__label">Office</div>
            <address class="contact-card__address">
              3400 N Central Expy #110-217<br />
              Richardson, TX 75080
            </address>
          </div>

          <div class="contact-card">
            <div class="contact-card__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-9h3l.5-4h-3.5V6.5c0-1.15.32-1.93 1.97-1.93H17V1.17C16.63 1.12 15.5 1 14.17 1 11.4 1 9.5 2.69 9.5 5.8V9H6.5v4h3v9h4z"/></svg>
            </div>
            <div class="contact-card__label">Follow</div>
            <a href="https://www.facebook.com/Mcknightandassociates/" rel="noopener" target="_blank" class="contact-card__value contact-card__value--small">Facebook →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Pre-fill the form from URL params (?interest=buy&city=Plano&price=$500k–$750k)
  (() => {
    const params = new URLSearchParams(window.location.search);
    const interest = params.get('interest');
    const city = params.get('city');
    const price = params.get('price');

    if (interest) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="interest"][value="${interest}"]`);
      if (radio) radio.checked = true;
    }

    if (city || price) {
      const message = document.querySelector<HTMLTextAreaElement>('#message');
      if (message && !message.value) {
        const verb = interest === 'rent' ? 'rent' : interest === 'sell' ? 'sell' : 'buy';
        const bits: string[] = [];
        bits.push(`I'm looking to ${verb}`);
        if (city) bits.push(`in ${city}`);
        if (price) bits.push(`— ${price}`);
        message.value = bits.join(' ') + '. Please get in touch.';
      }
    }
  })();
</script>

<style>
  .page-hero {
    background: var(--color-bg-soft);
    padding-block: clamp(4rem, 8vw, 6rem);
    border-bottom: 1px solid var(--color-line);
  }

  .brand-text { color: var(--color-brand); font-weight: 700; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .contact-form {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  @media (max-width: 520px) { .field-row { grid-template-columns: 1fr; } }

  label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  input[type="text"], input[type="email"], input[type="tel"], textarea {
    font: inherit;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(160, 37, 51, 0.12);
  }

  textarea { resize: vertical; min-height: 120px; }

  .field--radios {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .field--radios legend {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    padding: 0;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
    display: block;
    width: 100%;
  }

  .radios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 0.88rem;
    font-weight: 500;
    background: var(--color-bg);
  }

  .radio:hover { border-color: var(--color-brand); }
  .radio input { accent-color: var(--color-brand); }
  .radio:has(input:checked) {
    border-color: var(--color-brand);
    background: var(--color-brand-soft);
    color: var(--color-brand-dark);
  }

  .consent {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--color-muted);
    font-weight: 400;
    line-height: 1.5;
  }

  .consent input { margin-top: 0.2rem; accent-color: var(--color-brand); }

  .form-note {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0.25rem 0 0;
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-card {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    position: relative;
  }

  .contact-card__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    border-radius: 10px;
    margin-bottom: 0.85rem;
  }

  .contact-card__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .contact-card__value {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-ink);
    text-decoration: none;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .contact-card__value--small { font-size: 1rem; word-break: break-all; }
  .contact-card__value:hover { color: var(--color-brand); }

  .contact-card__meta {
    font-size: 0.83rem;
    color: var(--color-muted);
    margin-top: 0.4rem;
  }

  .contact-card__address {
    font-style: normal;
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
