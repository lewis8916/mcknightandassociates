---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Reach out to McKnight & Associates — Dallas-area real estate brokerage serving Richardson, Plano, Garland, and Frisco."
  path="/contact/"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Get in touch</span>
      <h1>Let's talk about what's next.</h1>
      <p class="lede">
        Buying, selling, or just kicking the tires — we're happy to walk through it. Fill out
        the form below or reach us directly.
      </p>

      <div class="contact-grid">
        <div>
          <form
            class="contact-form"
            name="contact"
            method="POST"
            action="https://formspree.io/f/your-form-id"
            aria-labelledby="contact-form-heading"
          >
            <h2 id="contact-form-heading" class="visually-hidden">Contact form</h2>

            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="phone">Phone <span class="optional">(optional)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>

            <div class="field">
              <label for="interest">I'm interested in</label>
              <select id="interest" name="interest">
                <option value="buying">Buying a home</option>
                <option value="selling">Selling a home</option>
                <option value="both">Both — I'm buying and selling</option>
                <option value="investing">Investing / rental property</option>
                <option value="other">Something else</option>
              </select>
            </div>

            <div class="field">
              <label for="message">How can we help?</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn">Send message</button>
            <p class="form-note">
              We reply personally, usually within one business day.
            </p>
          </form>
        </div>

        <aside class="contact-aside">
          <div class="contact-card">
            <div class="contact-card__heading">Direct contact</div>
            <ul>
              <li>
                <span class="label">Email</span>
                <a href="mailto:lewis@mcknight.com">lewis@mcknight.com</a>
              </li>
              <li>
                <span class="label">Phone</span>
                <a href="tel:+15555555555">(555) 555-5555</a>
              </li>
              <li>
                <span class="label">Office</span>
                <span>Dallas, Texas</span>
              </li>
              <li>
                <span class="label">Hours</span>
                <span>Mon–Sat, 9am – 7pm CT</span>
              </li>
            </ul>
          </div>

          <div class="contact-card">
            <div class="contact-card__heading">Service area</div>
            <p style="color:var(--color-muted);margin:0;">
              Dallas · Richardson · Plano · Garland · Frisco — and surrounding
              neighborhoods across the DFW metroplex.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .contact-form {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }

  @media (max-width: 520px) {
    .field-row { grid-template-columns: 1fr; }
  }

  label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-navy);
  }

  .optional {
    color: var(--color-muted);
    font-weight: 400;
  }

  input, select, textarea {
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-ink);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(176, 141, 87, 0.18);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0.25rem 0 0;
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 1.75rem;
  }

  .contact-card__heading {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent-dark);
    margin-bottom: 1rem;
  }

  .contact-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact-card li {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.95rem;
  }

  .contact-card .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
